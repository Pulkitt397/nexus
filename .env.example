# Nexus Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-2.5-flash)
# Free-tier options:
#   gemini-2.5-flash       — Best balance (500 req/day)
#   gemini-2.5-flash-lite  — Fastest (1500 req/day)
#   gemini-2.5-pro         — Most capable (25 req/day)
#   gemini-2.0-flash       — Legacy workhorse (1500 req/day)
#   gemini-2.0-flash-lite  — Legacy budget (1500 req/day)
#   gemini-1.5-flash       — Legacy reliable
#   gemini-1.5-pro         — Legacy capable (25 req/day)
# GEMINI_MODEL=gemini-2.5-flash
